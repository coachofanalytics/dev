{% include 'main/navbar_templates/home_navbar.html' %}
{% load static %}
{% block content %}

<style>
  body {
    background-color: #f8f9fa;
  }

  .volunteer-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 50px 15px;
  }

  .volunteer-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .volunteer-header h2 {
    font-size: 2rem;
    font-weight: 700;
    color: #222;
  }

  .volunteer-header p {
    font-size: 1.1rem;
    color: #555;
  }

  .add-btn {
    background-color: #0d6efd;
    color: white;
    border-radius: 30px;
    padding: 10px 25px;
    font-weight: 500;
    transition: 0.3s;
  }

  .add-btn:hover {
    background-color: #0056b3;
    color: #fff;
  }

  .volunteer-card {
    border: none;
    border-radius: 20px;
    background: white;
    box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    transition: 0.3s;
    text-align: center;
    padding: 25px 15px;
  }

  .volunteer-card:hover {
    transform: translateY(-5px);
  }

  .volunteer-img {
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 50%;
    margin-bottom: 15px;
  }

  .volunteer-card h5 {
    font-weight: 600;
    color: #222;
  }

  .volunteer-card p {
    color: #555;
    font-size: 0.95rem;
  }

  .btn-group {
    margin-top: 10px;
  }

  .btn-sm {
    border-radius: 30px;
  }

  .text-muted {
    font-size: 0.85rem;
  }
</style>

<div class="volunteer-section">
  <div class="volunteer-header">
    <h2>Become a Volunteer</h2>
    <p>Join our team of dedicated volunteers to support our projects and events.</p>
    <a href="#" class="btn add-btn mt-3">+ Add Volunteer</a>
  </div>

  <div class="row justify-content-center">
    {% for v in volunteers %}
      <div class="col-md-4 col-lg-3 mb-4">
        <div class="volunteer-card">
          <img src="{{ v.image.url }}" alt="{{ v.company_name }}" class="volunteer-img">
          <h5>{{ v.company_name }}</h5>
          <p>{{ v.motivation }}</p>
          <p class="text-muted">Registered on {{ v.created_at|date:"M d, Y" }}</p>
          <div class="btn-group">
            <a href="#" class="btn btn-outline-secondary btn-sm">View</a>
            <a href="#" class="btn btn-outline-primary btn-sm">Edit</a>
            <a href="#" class="btn btn-outline-danger btn-sm">Delete</a>
          </div>
        </div>
      </div>
    {% empty %}
      <p class="text-center">No volunteers have joined yet. Be the first to register!</p>
    {% endfor %}
  </div>
</div>

{% endblock %}
