# ============================================================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================================================

# Stripe Configuration
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# PayPal Configuration
# Get your credentials from: https://developer.paypal.com/developer/applications
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox

# M-Pesa Configuration (Safaricom - Kenya)
# Get your credentials from: https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
MPESA_BUSINESS_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey_here
MPESA_CALLBACK_URL=https://yourdomain.com/webhooks/mpesa/
MPESA_INITIATOR_NAME=your_initiator_name
MPESA_SECURITY_CREDENTIAL=your_security_credential

# Payment Feature Flags
ENABLE_STRIPE=True
ENABLE_PAYPAL=True
ENABLE_MPESA=True
ENABLE_WALLET_PAYMENTS=True

# Webhook URLs
STRIPE_WEBHOOK_URL=/webhooks/stripe/
PAYPAL_WEBHOOK_URL=/webhooks/paypal/
MPESA_WEBHOOK_URL=/webhooks/mpesa/

# Payment Encryption Key
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_ENCRYPTION_KEY=your_fernet_encryption_key_here
