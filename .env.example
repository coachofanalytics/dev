# Database Configuration
DB_NAME=biashara_bridges
DB_USER=postgres
DB_PASSWORD=your_database_password_here
DB_HOST=localhost
DB_PORT=5432

# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis Configuration (for Celery task queue)
# On Heroku, this will be provided automatically by the Redis addon
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# Email Backend (choose one):
# For development (prints emails to console):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For production (sends real emails via SMTP):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP Configuration (for production email sending)
# Gmail SMTP Example:
# 1. Use an App Password, not your regular Gmail password
# 2. Enable 2-Step Verification in your Google Account
# 3. Generate App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# Other Popular SMTP Providers:
#
# SendGrid:
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_sendgrid_api_key
#
# Mailgun:
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=postmaster@your-domain.mailgun.org
# EMAIL_HOST_PASSWORD=your_mailgun_password
#
# Amazon SES:
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_ses_smtp_username
# EMAIL_HOST_PASSWORD=your_ses_smtp_password

# Email Sender Information
DEFAULT_FROM_EMAIL=Biashara Bridges <noreply@biasharabridges.com>
SERVER_EMAIL=server@biasharabridges.com

# ============================================================================
# SOCIAL AUTHENTICATION CONFIGURATION
# ============================================================================

# Google OAuth2 Configuration
# Get your credentials from: https://console.cloud.google.com/apis/credentials
# 1. Create a new project or select existing one
# 2. Go to "Credentials" and create "OAuth 2.0 Client ID"
# 3. Set Authorized redirect URIs to: http://localhost:8000/oauth/complete/google-oauth2/
# 4. For production, add: https://yourdomain.com/oauth/complete/google-oauth2/
GOOGLE_OAUTH2_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH2_CLIENT_SECRET=your_google_client_secret_here

# Facebook OAuth2 Configuration
# Get your credentials from: https://developers.facebook.com/apps/
# 1. Create a new app or select existing one
# 2. Go to "Settings" > "Basic" to get App ID and App Secret
# 3. Add "Facebook Login" product to your app
# 4. In Facebook Login settings, add Valid OAuth Redirect URIs:
#    - http://localhost:8000/oauth/complete/facebook/
#    - For production: https://yourdomain.com/oauth/complete/facebook/
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# ============================================================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================================================

# Stripe Configuration
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# PayPal Configuration
# Get your credentials from: https://developer.paypal.com/developer/applications
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox

# M-Pesa Configuration (Safaricom - Kenya)
# Get your credentials from: https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
MPESA_BUSINESS_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey_here
MPESA_CALLBACK_URL=https://yourdomain.com/webhooks/mpesa/
MPESA_INITIATOR_NAME=your_initiator_name
MPESA_SECURITY_CREDENTIAL=your_security_credential

# CashApp Configuration (Square)
# Get your credentials from: https://developer.squareup.com/apps
# 1. Create a new application or select existing one
# 2. Go to "Credentials" to get Application ID and Access Token
# 3. Create a location and get the Location ID
# 4. For sandbox testing, use sandbox credentials
CASHAPP_APP_ID=your_cashapp_app_id_here
CASHAPP_CLIENT_ID=your_cashapp_client_id_here
CASHAPP_CLIENT_SECRET=your_cashapp_client_secret_here
CASHAPP_ACCESS_TOKEN=your_cashapp_access_token_here
CASHAPP_LOCATION_ID=your_cashapp_location_id_here

# Venmo Configuration (Braintree)
# Get your credentials from: https://www.braintreepayments.com/sandbox
# 1. Create a Braintree account or log in to sandbox
# 2. Go to "Account" > "API Keys, Tokenization Keys, Encryption Keys"
# 3. Copy Merchant ID, Public Key, and Private Key
# 4. Enable Venmo in Payment Methods settings
VENMO_MERCHANT_ID=your_venmo_merchant_id_here
VENMO_PUBLIC_KEY=your_venmo_public_key_here
VENMO_PRIVATE_KEY=your_venmo_private_key_here

# Payment Feature Flags
ENABLE_STRIPE=True
ENABLE_PAYPAL=True
ENABLE_MPESA=True
ENABLE_CASHAPP=True
ENABLE_VENMO=True
ENABLE_WALLET_PAYMENTS=True

# Webhook URLs
STRIPE_WEBHOOK_URL=/webhooks/stripe/
PAYPAL_WEBHOOK_URL=/webhooks/paypal/
MPESA_WEBHOOK_URL=/webhooks/mpesa/
CASHAPP_WEBHOOK_URL=/webhooks/cashapp/
VENMO_WEBHOOK_URL=/webhooks/venmo/

# Payment Encryption Key
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_ENCRYPTION_KEY=your_fernet_encryption_key_here
