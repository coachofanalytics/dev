# =============================================================================
# Biashara Bridges - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core Settings
# -----------------------------------------------------------------------------
# Generate a secure secret key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secure-secret-key-here

# Set to False in production!
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# -----------------------------------------------------------------------------
# Database Settings
# -----------------------------------------------------------------------------
USE_POSTGRESQL=False
USE_SQLITE_DEV=True

# PostgreSQL settings (only needed if USE_POSTGRESQL=True)
DB_NAME=biashara_bridges
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# -----------------------------------------------------------------------------
# Stripe Payment Gateway
# -----------------------------------------------------------------------------
STRIPE_PUBLIC_KEY=pk_test_your_public_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
ENABLE_STRIPE=True

# -----------------------------------------------------------------------------
# PayPal Payment Gateway
# -----------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
ENABLE_PAYPAL=True

# -----------------------------------------------------------------------------
# M-Pesa Payment Gateway
# -----------------------------------------------------------------------------
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_BUSINESS_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
ENABLE_MPESA=True
