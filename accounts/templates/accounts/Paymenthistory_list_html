{% extends "main/base_templates/accounts_base.html" %}
{% load static %}

{% block content %}
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-primary">💰 Payment History
    <a href="(% url 'accounts:paymenthistory_create'%)" class="btn btn-success">
      ➕ Add New Payment History
    </a>
  </div>

  <!-- Search Bar -->
  <form method="get" class="d-flex mb-3">
    <input type="text" name="search" class="form-control me-2"
           placeholder="Search by client, method, or plan..." value="{{ request.GET.search }}">
    <button type="submit" class="btn btn-outline-primary">Search</button>
  </form>

  <!-- Payment Table -->
  <div class="card shadow-sm">
    <div class="card-body table-responsive">
      {% if payments %}
      <table class="table table-hover align-middle">
        <thead class="table-dark">
          <tr>
            <th>ID</th>
            <th>Client</th>
            <th>Payment Fees</th>
            <th>Down Payment</th>
            <th>Bonus</th>
            <th>Plan</th>
            <th>Method</th>
            <th>Submitted</th>
            <th>Student Balance</th>
            <th> fee_balance</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for p in payments %}
          <tr>
            <td>{{ forloop.counter }}</td>
            <td>{{ p.customer_id.first_name }} {{ p.customer_id.last_name }}</td>
            <td>${{ p.payment_fees }}</td>
            <td>${{ p.down_payment }}</td>
            <td>${{ p.student_bonus }}</td>
            <td>{{ p.plan }}</td>
            <td><span class="badge bg-info text-dark">{{ p.payment_method }}</span></td>
            <td>{{ p.contract_submitted_date|date:"M d, Y" }}</td>
            <td>${{ p.student_balance }}</td>
            <td>${{ p.fee_balance }}</td>
            <td>
              <a href="#" class="btn btn-sm btn-outline-primary">View</a>
              <a href="#" class="btn btn-sm btn-outline-warning">Edit</a>
              <a href="#" class="btn btn-sm btn-outline-danger"
                 onclick="return confirm('Are you sure you want to delete this payment?');">Delete</a>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p class="text-center text-muted my-3">No payment records found.</p>
      {% endif %}
    </div>
  </div>

  <!-- Pagination -->
  {% if payments.has_other_pages %}
  <nav aria-label="Pagination" class="mt-4">
    <ul class="pagination justify-content-center">
      {% if payments.has_previous %}
      <li class="page-item">
        <a class="page-link" href="?page={{ payments.previous_page_number }}">Previous</a>
      </li>
      {% endif %}
      {% for i in payments.paginator.page_range %}
      <li class="page-item {% if i == payments.number %}active{% endif %}">
        <a class="page-link" href="?page={{ i }}">{{ i }}</a>
      </li>
      {% endfor %}
      {% if payments.has_next %}
      <li class="page-item">
        <a class="page-link" href="?page={{ payments.next_page_number }}">Next</a>
      </li>
      {% endif %}
    </ul>
  </nav>
  {% endif %}
</div>
{% endblock %}
