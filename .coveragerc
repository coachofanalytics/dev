[run]
source = .
omit =
    */migrations/*
    */tests/*
    */venv/*
    */env/*
    manage.py
    config/wsgi.py
    config/asgi.py
    */__pycache__/*
    */site-packages/*
plugins = django_coverage_plugin

[report]
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

[html]
directory = htmlcov
